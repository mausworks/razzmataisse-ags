{
  "$schema": "./schemas/theme.schema.json",
  "bar": {
    "transition": {
      "in": "300ms ease-out",
      "out": "600ms ease-in-out"
    },
    "palette": {
      "background": "#00000022",
      "activeBackground": "#00000099",
      "text": "#FFFFFF",
      "accent": "#1088EA",
      "accentText": "#FFFFFF",
      "success": "#32D74B",
      "danger": "#FF453A"
    },
    "workspaceIndicator": {
      "transition": "300ms ease-in",
      "size": 20,
      "spacing": 8
    }
  }
}