{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023", "ESNext.Disposable"],
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src/",
    "paths": {
      "@lib/*": ["lib/*"],
      "@widget/*": ["widget/*"],
      "@state/*": ["state/*"],
      "@ui/*": ["ui/*"],
      "@theme": ["theme.ts"]
    },
    // "checkJs": true,
    // "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4"
  }
}
