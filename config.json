{
  "$schema": "./schemas/config.schema.json",
  "bar": {
    "launcher": { "visible": true },
    "workspaces": { "visible": true, "max": 10, "backfill": true },
    "windowTitle": { "visible": true, "default": "Desktop" },
    "wifi": { "visible": true },
    "bluetooth": { "visible": true },
    "audio": { "visible": true },
    "clock": {
      "visible": true,
      "dateFormat": "%a %d %b",
      "timeFormat": "%H:%M",
      "interval": "1s"
    },
    "calendar": {
      "visible": true,
      "showWeekNumbers": true
    }
  },
  "search": {
    "roots": ["~"],
    "ignoredDesktopEntries": [
      "*cmake*",
      "*ccmake*",
      "*cpack*",
      "*ctest*",
      "*avahi*",
      "*bssh*",
      "*bvnc*"
    ],
    "ignoreGlobs": [
      "!.git",
      "!.cache",
      "!.local/share/Trash/**/*",
      "!.claude",
      "!.config/Claude/**",
      "!node_modules",
      "!.npm",
      "!.cargo",
      "!.rustup",
      "!.bun",
      "!.vscode",
      "!.models",
      "!.ollama",
      "!.docker",
      "!.mozilla",
      "!BraveSoftware",
      "!chromium",
      "!google-chrome",
      "!.histfile",
      "!.bash_history",
      "!.zsh_history",
      "!.python_history",
      "!.lesshst",
      "!.wget-hsts",
      "!.Xauthority",
      "!.ICEauthority",
      "!lost+found"
    ]
  }
}
